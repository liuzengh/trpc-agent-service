{
  "name": "agent-trpc-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run docs:sync && next dev",
    "build": "npm run docs:sync && next build",
    "lint": "tsc --noEmit",
    "test": "npm run docs:sync && vitest run",
    "docs:sync": "node scripts/build-docs.mjs",
    "docs:check": "node scripts/build-docs.mjs --check",
    "verify": "node scripts/verify-output.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.38.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "^29.1.1",
    "marked": "17.0.5",
    "typescript": "5.5.4",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
