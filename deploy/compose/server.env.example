# Public deployment settings only; credentials are generated in the setup volume.
TRPC_AGENT_IMAGE=trpc-agent-service:server
# Inherited variable name from the base Compose; this is the HOST loopback port.
TRPC_AGENT_DEMO_PORT=18080
TRPC_AGENT_BUILD_GOPROXY=https://proxy.golang.org,direct
TRPC_AGENT_MODEL_ENDPOINT_POLICY=public_https
TRPC_AGENT_MODEL_ALLOWED_ORIGINS=
