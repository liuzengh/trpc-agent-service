# Copy to .env.local. This file contains locators only; never put API keys here.
TRPC_REDIS_ENVIRONMENT=local-runtime
TRPC_WORKER_GROUP=local-workers
TRPC_WORKER_CONTROL_GROUP=local-worker-control
TRPC_WORKER_PROBE_TENANT_ID=replace-after-seeding
# Graph continuation checkpoints are tenant/config-version/namespace isolated.
TRPC_WORKER_GRAPH_CHECKPOINT_TTL=168h
# Optional governance DLP. Set all five locators/versions together; the Worker
# rejects partial configuration and policies requiring DLP fail closed without it.
# TRPC_DLP_ENDPOINT=https://dlp.example.test/
# TRPC_DLP_PROBE_TENANT_ID=replace-after-seeding
# TRPC_DLP_SECRET_REF=secret://local/dlp-service
# TRPC_DLP_SECRET_VERSION=1
# TRPC_DLP_BACKEND_VERSION=1
# Optional reviewed MCP tool endpoints. Each entry is tenant-scoped and maps to
# exactly one Tool Catalog registration (tool_id must equal the remote tool
# name). declaration_digest is the SHA-256 of the reviewed remote declaration;
# it and the endpoint binding are fixed by the published ToolRef. HTTPS
# SSE/streamable only; a malformed or drifted entry refuses execution.
# TRPC_MCP_ENDPOINTS=[{"tenant_id":"replace-after-seeding","tool_id":"weather_lookup","version":1,"transport":"streamable","server_url":"https://mcp.example.test/","declaration_digest":"<reviewed-64-char-sha256>","timeout":"10s","secret_ref":"secret://local/mcp-weather","secret_version":1,"secret_header":"Authorization","secret_prefix":"Bearer "}]
# Optional managed code-execution tools. Disabled unless both variables are
# supplied. The root must be a dedicated absolute directory, never this repo or
# the Skill staging root. Generate the digest with code-executor-binding-digests
# and copy it into both this entry and the published ToolRef.
# TRPC_CODE_EXECUTOR_WORKSPACE_ROOT=/var/lib/trpc-agent-service/codeexecutor
# TRPC_CODE_EXECUTORS=[{"tenant_id":"replace-after-seeding","tool_id":"sandbox_execute_code","version":1,"content_digest":"<reviewed-64-char-binding-digest>"}]
# Optional official-Qdrant retrieval backend for tenant-scoped knowledge. All
# fields are required together; agents with knowledge refs fail closed without it.
# TRPC_QDRANT_HOST=qdrant
# TRPC_QDRANT_PORT=6333
# TRPC_QDRANT_COLLECTION=knowledge_retrieval
# TRPC_QDRANT_DIMENSION=1024
# TRPC_QDRANT_TLS=false
# TRPC_QDRANT_API_KEY_REF=secret://local/qdrant
# TRPC_QDRANT_API_KEY_VERSION=1
TRPC_PAYLOAD_KEY_REF=secret://local/payload-key
TRPC_PAYLOAD_KEY_VERSION=1
TRPC_GATEWAY_PROBE_TENANT_ID=replace-after-seeding
TRPC_GATEWAY_AUTH_SECRET_REF=secret://local/gateway-auth
TRPC_GATEWAY_AUTH_SECRET_VERSION=1
TRPC_GATEWAY_PUBLIC_BASE_URL=https://replace-with-tls-ingress.example.test
# Admin uses a separate signing key and must be exposed only through an
# internal ingress. This tenant must exist after local bootstrap.
TRPC_ADMIN_PROBE_TENANT_ID=replace-after-seeding
TRPC_ADMIN_AUTH_SECRET_REF=secret://local/admin-auth
TRPC_ADMIN_AUTH_SECRET_VERSION=1
# The Admin console normally requires HTTPS. Docker Desktop local-only UI may
# opt in explicitly; never use this setting behind an ingress or public port.
TRPC_ADMIN_ALLOW_INSECURE_SESSION_COOKIE=true
TRPC_LOCAL_ADMIN_PORT=58083
TRPC_S3_REGION=us-east-1
TRPC_S3_BUCKET=local-artifacts
TRPC_S3_ALLOW_INSECURE=true
TRPC_WEBUI_ENABLED=true
TRPC_CHANNEL_PROBE_TENANT_ID=replace-after-seeding
TRPC_CHANNEL_DELIVERY_GROUP=local-channel-delivery
TRPC_WEBUI_LOCAL_ROUTE_KEY=local-webui
TRPC_WEBUI_LOCAL_TOKEN=local-webui-token-change-me
# Compose fixes this to the dedicated webui-local-skills volume. Outside
# Compose it must be an absolute directory distinct from the local secret root.
# TRPC_WEBUI_LOCAL_SKILL_STAGING_ROOT=/var/lib/trpc-webui-local/skills
TRPC_LOCAL_WEBUI_PORT=58081
# Independent append-only compliance database; do not point this at the source DB.
TRPC_LOCAL_COMPLIANCE_POSTGRES_USER=compliance
TRPC_LOCAL_COMPLIANCE_POSTGRES_PASSWORD=replace-for-nonlocal-use
TRPC_LOCAL_COMPLIANCE_POSTGRES_DB=trpc_agent_compliance
TRPC_LOCAL_COMPLIANCE_POSTGRES_PORT=55433
# Optional Audit Relay low-cardinality backlog thresholds.
TRPC_LOCAL_AUDIT_LAG_POLL_INTERVAL=5s
TRPC_LOCAL_AUDIT_LAG_ALERT_AGE=5m
TRPC_LOCAL_AUDIT_LAG_ALERT_COUNT=10000
# Build/release identity attached to OTel resource attributes.
TRPC_LOCAL_SERVICE_VERSION=development
TRPC_LOCAL_JAEGER_PORT=56686
TRPC_LOCAL_OTEL_HTTP_PORT=54318
TRPC_LOCAL_OTEL_PROMETHEUS_PORT=59464
