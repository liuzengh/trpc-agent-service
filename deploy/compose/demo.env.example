# Public settings only. Do not put credentials here.
# Passing --env-file explicitly prevents Compose from loading the daily .env.
TRPC_AGENT_DEMO_PORT=18080
# Public build proxy used by this local example. Replace with your company's
# mirror or https://proxy.golang.org,direct when appropriate for your network.
TRPC_AGENT_BUILD_GOPROXY=https://goproxy.cn,direct
# Default: any public HTTPS provider. Enter its Base URL and Key in the UI.
# Use allowlist for a deployment that must restrict destinations.
TRPC_AGENT_MODEL_ENDPOINT_POLICY=public_https
# Optional trusted origins for local/private/HTTP models or proxy egress.
# No /v1 or credentials. Example: http://host.docker.internal:8787
TRPC_AGENT_MODEL_ALLOWED_ORIGINS=
