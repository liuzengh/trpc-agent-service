# Copy to .env.live-im. This file contains only non-secret locators and absolute
# credential-file paths. Never place app_secret/corp_secret values here.
TRPC_LIVE_IM_PROVIDER_SMOKE=1

# Choose: feishu, wecom, or feishu,wecom
TRPC_LIVE_IM_PROVIDERS=feishu,wecom

# Feishu credential file content (chmod 600):
# {"app_id":"cli_xxx","app_secret":"..."}
TRPC_LIVE_FEISHU_SECRET_FILE=/absolute/path/to/feishu.json
TRPC_LIVE_FEISHU_APP_ID=cli_xxx
# An authorized existing message ID that the app may reply to.
TRPC_LIVE_FEISHU_MESSAGE_ID=om_xxx

# WeCom Agent credential file content (chmod 600):
# {"corp_id":"ww_xxx","corp_secret":"...","agent_id":1000002}
TRPC_LIVE_WECOM_SECRET_FILE=/absolute/path/to/wecom.json
TRPC_LIVE_WECOM_CORP_ID=ww_xxx
# An authorized test user visible to the Agent application.
TRPC_LIVE_WECOM_USER_ID=test_user
