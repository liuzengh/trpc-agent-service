# Copy this file to deploy/compose/secrets/feishu.env. The destination is
# gitignored; never commit real values.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Optional for p2p smoke. It is required before this local binding will accept
# group messages, where strict @mention checks must prove the addressed bot.
FEISHU_BOT_OPEN_ID=
