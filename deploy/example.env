# Local-only values for the deployment quick start. Replace every credential
# before using a shared environment or a production deployment.
POSTGRES_DB=trpc_agent
POSTGRES_USER=trpc
POSTGRES_PASSWORD=trpc-local-password
# Optional override. When omitted, Compose derives this DSN from POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB above.
# TRPC_POSTGRES_DSN=postgres://trpc:trpc-local-password@postgres:5432/trpc_agent?sslmode=disable
# TRPC_SERVICE_IMAGE=trpc-agent-service:local
TRPC_API_TOKEN=local-api-token
TRPC_TENANT_ID=t_01ARZ3NDEKTSV4RRFFQ69G5FAV
TRPC_APP_ID=app_01ARZ3NDEKTSV4RRFFQ69G5FAV
TRPC_ADMIN_TOKEN=local-admin-token
# Explicit platform-admin wildcard for the local control-plane demo. Use
# comma-separated tenant IDs for least-privilege shared/production deployments.
TRPC_ADMIN_TENANTS=*
# Browser console login. Leave both empty to keep bearer-only service mode.
TRPC_ADMIN_USERNAME=admin
TRPC_ADMIN_PASSWORD=change-me-local
TRPC_MODEL_API_KEY=local-development-key
TRPC_SESSION_BACKEND=postgres
# Redis is available in Compose for an explicit TRPC_SESSION_BACKEND=redis
# deployment. The local service has no password; external deployments should
# inject TRPC_REDIS_PASSWORD through a secret manager.
# TRPC_REDIS_ADDR=redis:6379
# TRPC_REDIS_PASSWORD=
# TRPC_REDIS_DB=0
# TRPC_REDIS_KEY_PREFIX=trpc:runtime:v1
# TRPC_REDIS_SECRET_REF=env/trpc-redis-password
# TRPC_REDIS_DIAL_TIMEOUT=500ms
# TRPC_REDIS_READ_TIMEOUT=500ms
# TRPC_REDIS_WRITE_TIMEOUT=500ms
# TRPC_REDIS_POOL_SIZE=10
# Optional S3-compatible Artifact provider credentials. They are only
# consumed through the tenant-scoped SecretResolver when an S3 Backend
# Profile binding is materialized. Leave empty when S3 is not used.
# TRPC_S3_ACCESS_KEY_ID=minio-local-access
# TRPC_S3_SECRET_KEY=minio-local-secret
# TRPC_S3_SECRET_REF=env/trpc-s3-credentials
# TRPC_MINIO_PORT=9000
# TRPC_MINIO_CONSOLE_PORT=9001
TRPC_MODEL_PROVIDER=openai
TRPC_MODEL_NAMES=gpt-4o-mini
TRPC_MODEL_ENDPOINT_HOSTS=api.openai.com
TRPC_MODEL_SECRET_REF=env/trpc-model-api-key
TRPC_DEMO_MODE=false
TRPC_HTTP_PORT=8080

# Optional OTLP/HTTP export. Empty endpoint keeps the no-op provider.
OTEL_SERVICE_NAME=trpc-agent-service
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_INSECURE=false
