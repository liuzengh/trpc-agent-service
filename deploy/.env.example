POSTGRES_USER=trpc_local
POSTGRES_PASSWORD=replace-with-a-local-random-password
POSTGRES_DB=trpc_agent
PLATFORM_DB_USER=trpc_platform
PLATFORM_DB_PASSWORD=replace-with-a-local-random-password
MINIO_ROOT_USER=trpc_minio
MINIO_ROOT_PASSWORD=replace-with-a-local-random-password

# Application composition root
# Local development only; production service replicas keep AUTO_MIGRATE false.
AUTO_MIGRATE=true
CONFIG_PATH=./configs/platform.example.json
# Single runtime PostgreSQL connection. Tenant-scoped transactions switch to
# the internal NOLOGIN trpc_tenant role so FORCE RLS still applies.
DATABASE_URL=postgres://trpc_platform:replace-with-a-local-random-password@localhost:5432/trpc_agent?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=agent.inbound.v1
KAFKA_GROUP_ID=trpc-agent-worker

# Optional telemetry exports. Production Kubernetes already sends OTLP to the
# Collector, whose Prometheus exporter listens on :9464.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# PROMETHEUS_ENABLED=true
# LANGFUSE_PUBLIC_KEY=pk-...
# LANGFUSE_SECRET_KEY=sk-...
# LANGFUSE_HOST=cloud.langfuse.com:443
# LANGFUSE_INSECURE=true
# LANGFUSE_OBSERVATION_LEAF_VALUE_MAX_BYTES=8192

# Runtime secrets referenced by platform-managed provider and binding catalogs.
MODEL_API_KEY=replace-with-model-api-key
# Required only by configs/platform.s3.example.json (keep real credentials out of JSON configuration files).
AUDIT_HMAC_KEY=replace-with-at-least-32-random-bytes
# S3_CONFIG_JSON={"endpoint":"https://s3.example.com","region":"us-east-1","bucket":"trpc-artifacts","access_key":"replace-me","secret_key":"replace-me"}

# Required when configs/platform.example.json enables Telegram
TELEGRAM_EXAMPLE_CONFIG_JSON={"secret_token":"replace-with-telegram-webhook-secret","bot_token":"replace-with-telegram-bot-token","api_base_url":"https://api.telegram.org"}

# Required only when a WeCom channel binding is configured
# WECOM_TOKEN=
# WECOM_ENCODING_AES_KEY=
# WECOM_CORP_ID=
# WECOM_ACCESS_TOKEN=
# WECOM_AGENT_ID=
# WECOM_API_BASE_URL=https://qyapi.weixin.qq.com
