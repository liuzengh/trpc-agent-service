# Generate independent random values. Never commit the real .env file.
POSTGRES_PASSWORD=
MASTER_KEY=
SERVICE_AUTH_SECRET=
# Shared HMAC key for stable tenant-scoped user pseudonyms in audit logs. If
# omitted, raw external user IDs are replaced with a redaction marker.
AUDIT_IDENTITY_HMAC_KEY=
ADMIN_API_TOKEN=
# Optional JSON array of additional scoped principals. Tokens must be at least
# 32 characters and are hashed in memory at startup.
ADMIN_PRINCIPALS_JSON=
# Optional for the loopback-only development stack. When set, every service
# requires this bearer token and Prometheus uses the same value for scraping.
METRICS_AUTH_TOKEN=
METRICS_TENANT_ALLOWLIST=
METRICS_AGENT_ALLOWLIST=
METRICS_MODEL_ALLOWLIST=
GRAFANA_PASSWORD=
# Loopback host ports. Override these for an isolated sandbox when another
# compose project already occupies the defaults.
POSTGRES_HOST_PORT=5432
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
GATEWAY_HOST_PORT=8080
ADMIN_HOST_PORT=8081
PROMETHEUS_HOST_PORT=9095
GRAFANA_HOST_PORT=3000
# Public JSON profile catalog. Empty is the safe local default; see the
# Kubernetes README for validated Qdrant/S3 examples.
DATA_PLANE_PROFILES=[]
# Worker-only credentials. Set only names referenced by DATA_PLANE_PROFILES.
DATA_PLANE_QDRANT_API_KEY=
DATA_PLANE_EMBEDDING_API_KEY=
DATA_PLANE_S3_ACCESS_KEY=
DATA_PLANE_S3_SECRET_KEY=
# Public operator MCP catalog. Production endpoints require HTTPS. The local
# example may set allowInsecure only for an isolated development MCP server.
MCP_PROFILES=[]
# Example header value referenced as env://TRPC_SECRET_MCP_SUPPORT_AUTH.
TRPC_SECRET_MCP_SUPPORT_AUTH=
# Model credentials are mounted only into Worker and Summary Worker. Tenant
# model JSON should use apiKeyRef: env://TRPC_SECRET_OPENAI_API_KEY.
TRPC_SECRET_OPENAI_API_KEY=
# IM credentials are mounted only into Gateway and Delivery. A WeCom binding
# should reference these names instead of storing raw credentials in JSON.
TRPC_SECRET_WECOM_TOKEN=
TRPC_SECRET_WECOM_CORP_SECRET=
TRPC_SECRET_WECOM_AES=
# Telegram uses the same split: bot token for delivery, webhook secret for
# callback authentication. Both processes currently receive the selected
# channel credential set, while all other services receive neither.
TRPC_SECRET_TELEGRAM_BOT_TOKEN=
TRPC_SECRET_TELEGRAM_WEBHOOK=
CONSUMER_CONCURRENCY=4
DELIVERY_CONCURRENCY=4
SUMMARY_CONCURRENCY=4
SUMMARY_POLL_INTERVAL=250ms
SUMMARY_JOB_TIMEOUT=2m
SUMMARY_LEASE_TTL=3m
SUMMARY_SESSION_LOCK_TTL=30s
SUMMARY_MIN_EVENTS=20
SUMMARY_MAX_WORDS=256
SUMMARY_MAX_OUTPUT_TOKENS=512
SUMMARY_SHUTDOWN_TIMEOUT=3m
# Shared with Worker and checked against its live health capability.
EXECUTION_TIMEOUT=90s
# Includes Worker execution, response completion, network and persistence time.
PROCESS_TIMEOUT=150s
INBOX_LEASE_DURATION=3m
DELIVERY_TIMEOUT=30s
OUTBOX_LEASE_DURATION=1m
WORKER_CACHE_SIZE=128
WORKER_CACHE_IDLE_TTL=10m
WORKER_CACHE_SWEEP_INTERVAL=1m
EXECUTION_LEASE_TTL=15m
EXECUTION_HEARTBEAT_INTERVAL=4m
EXECUTION_RECONCILE_INTERVAL=1m
EXECUTION_RECONCILE_BATCH=100
