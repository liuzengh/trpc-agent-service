# Local development only. Copy to data/local.env and chmod 600 before editing.
# Existing process environment takes precedence over this file.
TRPC_SERVICE_ADDR=127.0.0.1:8080
TRPC_SERVICE_STORAGE_PROFILE=inmemory
TRPC_SERVICE_SESSION_COORDINATION=inmemory

# Used only with STORAGE_PROFILE=postgres. These are public dev placeholders.
TRPC_SERVICE_POSTGRES_DSN=postgres://trpc:trpc-local-dev@127.0.0.1:55432/trpc_session?sslmode=disable
TRPC_SERVICE_POSTGRES_SCHEMA=public

TRPC_SERVICE_WECOM_ENABLED=false
TRPC_SERVICE_WECOM_TENANT_ID=demo
TRPC_SERVICE_WECOM_APP_ID=echo
TRPC_SERVICE_WECOM_BINDING_ID=wecom-local
TRPC_SERVICE_WECOM_BOT_ID=
TRPC_SERVICE_WECOM_BOT_SECRET=

TRPC_SERVICE_FEISHU_ENABLED=false
TRPC_SERVICE_FEISHU_TENANT_ID=demo
TRPC_SERVICE_FEISHU_AGENT_APP_ID=echo
TRPC_SERVICE_FEISHU_BINDING_ID=feishu-local
# APP_ID identifies the external Feishu app; AGENT_APP_ID is the internal app.
TRPC_SERVICE_FEISHU_APP_ID=
TRPC_SERVICE_FEISHU_APP_SECRET=

TRPC_SERVICE_TELEMETRY_ENABLED=false
TRPC_SERVICE_OTLP_ENDPOINT=http://127.0.0.1:4318
