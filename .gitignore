# local secrets
deploy/.env

# Keep deterministic console bundles under version control even though the
# repository-wide dist/ rule ignores other build outputs. Legacy hashed files
# stay ignored and may remain locally without entering commits.
.toolchain/
!webui/dist/
!webui/dist/**
webui/dist/assets/index-*.js
webui/dist/assets/index-*.css
# frontend toolchain artifacts (dist is committed for go:embed)
webui/node_modules/
webui/.vite/

# browser E2E artifacts
tests/browser/node_modules/
tests/browser/artifacts/
# generated coverage reports
tests/coverage/artifacts/
webui/coverage/

# runtime evidence snapshots (regenerated by scripts/kind-e2e.sh and the
# infrastructure smoke tests; keep the README.md next to them for provenance)
deploy/kubernetes/kind/evidence/*.txt
tests/infrastructure/artifacts/*.txt
tests/infrastructure/artifacts/*.log
# local coding-agent workspace
/.agents/
/agent/skills/
/AGENTS.md
/skills-lock.json
