FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/deployment-e2e ./cmd/deployment-e2e

FROM alpine:3.20

RUN apk add --no-cache ca-certificates \
    && addgroup -S trpc \
    && adduser -S -G trpc trpc

COPY --from=build /out/deployment-e2e /usr/local/bin/deployment-e2e

USER trpc

ENTRYPOINT ["/usr/local/bin/deployment-e2e"]
