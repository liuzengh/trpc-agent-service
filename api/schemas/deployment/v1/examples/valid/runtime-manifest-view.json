{
  "schema_version": "v1",
  "compiler_version": "deployment-compiler-v1",
  "runtime_contract_version": "worker-manifest-v1",
  "platform_contract": {
    "version": "platform-v1",
    "digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"
  },
  "tenant_id": "tnt_fixture_tenant",
  "sources": {
    "agent": {
      "agent_id": "agt_fixture_agent",
      "version_number": 3,
      "version_id": "agv_fixture_version",
      "schema_version": "v1",
      "digest": "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    },
    "profile": {
      "profile_id": "rpf_fixture_profile",
      "revision_number": 2,
      "revision_id": "rpr_fixture_revision",
      "schema_version": "v1",
      "digest": "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    }
  },
  "agent_plan": {
    "root": "assistant",
    "nodes": {
      "assistant": {
        "kind": "llm",
        "instruction": "Answer with the selected resources.",
        "model_resource": "primary",
        "tool_resources": [
          "search"
        ],
        "knowledge_resources": [
          "docs"
        ],
        "callable_entries": [
          "knowledge/docs",
          "tools/search"
        ]
      }
    }
  },
  "resources": {
    "models": {
      "primary": {
        "adapter_version": "openai-compatible-v1",
        "kind": "openai_compatible",
        "model": "fixture-chat-model",
        "base_url": "https://model.example.test/v1",
        "credential_present": true,
        "capabilities": [
          "chat",
          "tool_call"
        ]
      }
    },
    "tools": {
      "search": {
        "adapter_version": "mcp-web-search-v1",
        "kind": "mcp_streamable_http",
        "server_url": "https://tools.example.test/mcp",
        "toolset_name": "internet",
        "tool_name": "search_web",
        "auth": {
          "kind": "bearer",
          "credential_present": true
        },
        "capability": "web.search"
      }
    },
    "knowledge": {
      "docs": {
        "adapter_version": "qdrant-openai-v1",
        "kind": "qdrant_openai",
        "host": "qdrant.example.test",
        "port": 6334,
        "tls": true,
        "collection": "fixture_docs",
        "credential_present": true,
        "embedding": {
          "model": "fixture-embedding-model",
          "base_url": "https://embedding.example.test/v1",
          "dimensions": 1536,
          "credential_present": true
        },
        "capability": "knowledge.search"
      }
    },
    "storage": {
      "session": {
        "adapter_version": "postgres-state-v1",
        "kind": "postgres_state",
        "destination": {
          "host": "state.example.test",
          "port": 5432,
          "database": "agent_state",
          "username": "agent",
          "sslmode": "verify-full"
        },
        "credential_present": true
      }
    }
  },
  "resolved_requirements": {
    "models": {
      "primary": "primary"
    },
    "tools": {
      "search": "search"
    },
    "knowledge": {
      "docs": "docs"
    }
  },
  "storage_roles": {
    "session": "session"
  },
  "execution": {
    "backend": "worker-process-v1",
    "allowed_endpoint_hosts": [
      "embedding.example.test",
      "model.example.test",
      "qdrant.example.test",
      "state.example.test",
      "tools.example.test"
    ],
    "max_run_seconds": 120,
    "max_tool_calls": 16,
    "max_output_tokens": 4096
  }
}
