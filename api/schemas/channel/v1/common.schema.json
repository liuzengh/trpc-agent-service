{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/common.schema.json",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "purpose": {
      "enum": [
        "telegram.bot_token",
        "telegram.webhook_secret",
        "wecom.bot_secret"
      ]
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "telegram.bot_token",
            "telegram.webhook_secret",
            "wecom.bot_secret"
          ]
        },
        "credential_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "credential_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "configured": {
          "type": "boolean"
        }
      },
      "required": [
        "purpose",
        "credential_id",
        "credential_version",
        "configured"
      ]
    },
    "use": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "enum": [
            "telegram.bot_token",
            "telegram.webhook_secret",
            "wecom.bot_secret"
          ]
        },
        "credential_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "credential_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "purpose",
        "credential_id",
        "credential_version"
      ]
    },
    "consumer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "wecom_connection"
            },
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "not": {
                "pattern": "[^A-Za-z0-9._:-]"
              }
            },
            "owner_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "instance_id",
            "owner_epoch"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "telegram_webhook",
                "telegram_delivery"
              ]
            },
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "not": {
                "pattern": "[^A-Za-z0-9._:-]"
              }
            }
          },
          "required": [
            "kind",
            "instance_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "telegram_registration"
            },
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "not": {
                "pattern": "[^A-Za-z0-9._:-]"
              }
            },
            "registration_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "instance_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "telegram_receiver"
            },
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "not": {
                "pattern": "[^A-Za-z0-9._:-]"
              }
            },
            "owner_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "instance_id",
            "owner_epoch"
          ]
        }
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "provider": {
          "enum": [
            "telegram",
            "wecom"
          ]
        },
        "provider_account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "account_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "connection_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "enabled": {
          "type": "boolean"
        },
        "min_route_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "config": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "webhook_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^/v1/telegram/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "receive_mode": {
                  "enum": [
                    "long_polling",
                    "webhook"
                  ]
                },
                "endpoint_profile": {
                  "type": "string",
                  "enum": [
                    "official",
                    "test"
                  ]
                }
              },
              "required": [
                "webhook_path"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bot_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "bot_id"
              ]
            }
          ]
        },
        "credentials": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/credential"
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": [
        "tenant_id",
        "account_id",
        "provider",
        "provider_account_id",
        "account_revision",
        "connection_revision",
        "enabled",
        "min_route_generation",
        "config",
        "credentials"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "telegram"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "provider_account_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[1-9][0-9]*$",
                "not": {
                  "pattern": "[^0-9]"
                }
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "webhook_path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^/v1/telegram/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "receive_mode": {
                    "enum": [
                      "long_polling",
                      "webhook"
                    ]
                  },
                  "endpoint_profile": {
                    "type": "string",
                    "enum": [
                      "official",
                      "test"
                    ]
                  }
                },
                "required": [
                  "webhook_path"
                ]
              },
              "credentials": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/credential",
                  "properties": {
                    "purpose": {
                      "enum": [
                        "telegram.bot_token",
                        "telegram.webhook_secret"
                      ]
                    }
                  }
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "config": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bot_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": [
                  "bot_id"
                ]
              },
              "credentials": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/credential",
                  "properties": {
                    "purpose": {
                      "const": "wecom.bot_secret"
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "not": {
            "pattern": "[^A-Za-z0-9._:-]"
          }
        },
        "revision_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "deployment_id",
        "revision_number"
      ]
    },
    "edit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "replace"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            }
          },
          "required": [
            "action",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "keep",
                "clear"
              ]
            }
          },
          "required": [
            "action"
          ]
        }
      ]
    },
    "secret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]{1,256}$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "not": {
        "pattern": "[^a-z0-9:]"
      }
    }
  }
}
