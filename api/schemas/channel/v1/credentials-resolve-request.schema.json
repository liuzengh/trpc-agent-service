{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/credentials-resolve-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "connection_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "uses": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/use"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "consumer": {
      "$ref": "common.schema.json#/$defs/consumer"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "source_epoch",
    "connection_revision",
    "uses",
    "consumer"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "consumer": {
            "properties": {
              "kind": {
                "const": "wecom_connection"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/use"
            },
            "minItems": 1,
            "maxItems": 1,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "wecom.bot_secret"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consumer": {
            "properties": {
              "kind": {
                "const": "telegram_webhook"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/use"
            },
            "minItems": 1,
            "maxItems": 1,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "telegram.webhook_secret"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consumer": {
            "properties": {
              "kind": {
                "const": "telegram_delivery"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/use"
            },
            "minItems": 1,
            "maxItems": 1,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "telegram.bot_token"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consumer": {
            "properties": {
              "kind": {
                "const": "telegram_registration"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/use"
            },
            "minItems": 2,
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "telegram.bot_token"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "telegram.webhook_secret"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "consumer": {
            "properties": {
              "kind": {
                "const": "telegram_receiver"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "uses": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/use"
            },
            "minItems": 1,
            "maxItems": 1,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "telegram.bot_token"
                    }
                  },
                  "required": [
                    "purpose"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          }
        }
      }
    }
  ]
}
