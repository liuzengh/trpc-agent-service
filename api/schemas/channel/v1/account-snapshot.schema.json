{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/account-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "snapshot_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "snapshot_digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "complete": {
      "const": true
    },
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/account"
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "source_epoch",
    "snapshot_revision",
    "snapshot_digest",
    "complete",
    "accounts"
  ]
}
