{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jfsas.dev/schemas/channel/v1/credentials-resolve-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "minLength": 36,
      "maxLength": 36
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "not": {
        "pattern": "[^A-Za-z0-9._:-]"
      }
    },
    "connection_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "purpose": {
            "enum": [
              "telegram.bot_token",
              "telegram.webhook_secret",
              "wecom.bot_secret"
            ]
          },
          "credential_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "not": {
              "pattern": "[^A-Za-z0-9._:-]"
            }
          },
          "credential_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "required": [
          "purpose",
          "credential_id",
          "credential_version",
          "value"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "purpose": {
                  "const": "telegram.webhook_secret"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_-]{1,256}$",
                  "not": {
                    "pattern": "[^A-Za-z0-9_-]"
                  }
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 2
    }
  },
  "required": [
    "scope_id",
    "source_epoch",
    "tenant_id",
    "account_id",
    "connection_revision",
    "values"
  ]
}
