{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trpc-agent-service.local/events/execution/v1/reply-intent.schema.json",
  "title": "ReplyIntent",
  "description": "Execution-owned immutable committed text Final. No destination, credentials, transport or owner fences; Gateway resolves the original Admission and verifies committed execution facts. A Gateway-owned durable part plan follows acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "admission_id",
    "run_id",
    "execution",
    "sequence",
    "kind",
    "content",
    "deadline"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "admission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "execution": {
      "$ref": "#/$defs/ReplyExecution"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "const": "final"
    },
    "content": {
      "$ref": "#/$defs/FinalTextContent"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "maxLength": 30,
      "description": "Canonical UTC RFC3339Nano; codec rejects equivalent but noncanonical offset/fraction spellings."
    }
  },
  "$defs": {
    "ReplyExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "generation",
        "completion_id"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "completion_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      }
    },
    "FinalTextContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[^\u0000]*$",
          "description": "Complete logical Final, at most 65536 UTF-8 bytes enforced by codec. Not provider markup."
        },
        "attachments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ReplyAttachment"
          },
          "x-go-type": "[]ReplyAttachment"
        }
      }
    },
    "ReplyAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "mime_type",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mime_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[^\\r\\n]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
