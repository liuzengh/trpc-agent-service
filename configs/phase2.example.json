{
  "schema_version": 1,
  "tenants": [
    {"id": "tenant-redis", "enabled": true},
    {"id": "tenant-memory", "enabled": true}
  ],
  "storage_profiles": [
    {
      "tenant_id": "tenant-redis",
      "id": "redis-main-v1",
      "kind": "redis",
      "credential_ref": "env:PHASE2_REDIS_URL",
      "key_prefix": "trpc-agent-service:phase2"
    },
    {
      "tenant_id": "tenant-memory",
      "id": "memory-local-v1",
      "kind": "inmemory"
    }
  ],
  "agent_apps": [
    {
      "tenant_id": "tenant-redis",
      "id": "assistant",
      "enabled": true,
      "active_config_version": "v1"
    },
    {
      "tenant_id": "tenant-memory",
      "id": "assistant",
      "enabled": true,
      "active_config_version": "v1"
    }
  ],
  "config_versions": [
    {
      "tenant_id": "tenant-redis",
      "agent_app_id": "assistant",
      "version": "v1",
      "storage_profile_id": "redis-main-v1",
      "instruction": "You are the Redis-backed tenant assistant.",
      "model": {
        "name": "model-name",
        "base_url": "https://example.test/v1",
        "credential_ref": "env:PHASE2_MODEL_KEY",
        "request_timeout": "60s",
        "max_output_tokens": 1024
      }
    },
    {
      "tenant_id": "tenant-memory",
      "agent_app_id": "assistant",
      "version": "v1",
      "storage_profile_id": "memory-local-v1",
      "instruction": "You are the local development tenant assistant.",
      "model": {
        "name": "model-name",
        "base_url": "https://example.test/v1",
        "credential_ref": "env:PHASE2_MODEL_KEY",
        "request_timeout": "60s",
        "max_output_tokens": 1024
      }
    }
  ],
  "channel_bindings": [
    {
      "id": "demo-redis",
      "channel": "demo",
      "external_account_id": "demo-redis",
      "tenant_id": "tenant-redis",
      "agent_app_id": "assistant",
      "enabled": true
    },
    {
      "id": "demo-memory",
      "channel": "demo",
      "external_account_id": "demo-memory",
      "tenant_id": "tenant-memory",
      "agent_app_id": "assistant",
      "enabled": true
    }
  ]
}
