# Telegram Bot
# Create a bot with @BotFather. Use the bot username without the leading @.
TRPC_TELEGRAM_BOT_USERNAME=
TRPC_TELEGRAM_BOT_TOKEN=

# Enterprise WeChat API-mode Smart Bot
# Create an API-mode Smart Bot in Enterprise WeChat and copy its BotID and
# long-connection Secret. These are not self-built application credentials.
TRPC_WECOM_BOT_ID=
TRPC_WECOM_BOT_SECRET=

# OpenAI-compatible model
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
