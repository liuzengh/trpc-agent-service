# Copy this file to .env and replace the placeholder locally. Never commit .env.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
POSTGRES_PASSWORD=local-postgres-password
TRPC_AGENT_GATEWAY_TOKEN_DEMO_HTTP=local-secret
# Per-(tenant,binding) fixed-window callback limit shared through Redis.
TRPC_AGENT_GATEWAY_RATE_LIMIT=100
# Admin API credentials: name=token:tenant-list, separated by ';', '*' means all tenants.
# Leave empty to keep the Admin API fail-closed; set a strong deployment secret explicitly.
TRPC_AGENT_ADMIN_TOKENS=
# Optional HTTPS bootstrap for published SecretRefs with provider vault/kms.
# Tokens are process bootstrap secrets and must come from the deployment secret store.
TRPC_AGENT_VAULT_ENDPOINT=
TRPC_AGENT_VAULT_TOKEN=
TRPC_AGENT_KMS_ENDPOINT=
TRPC_AGENT_KMS_TOKEN=
# Optional SecretRef target for PostgreSQL-to-PostgreSQL migrations.
# Apply repository migrations to the target before publishing migration_target.
TRPC_AGENT_STORAGE_TARGET_DSN=
# Optional Knowledge/Artifact SecretRefs. S3_CREDENTIAL_JSON must contain access_key_id,
# secret_access_key, region and path_style; keep the real JSON only in .env or
# a mounted secret provider, never in published YAML.
EMBEDDING_API_KEY=
QDRANT_API_KEY=
S3_CREDENTIAL_JSON=
# Optional MCP/business-tool SecretRef targets. Set only when the corresponding published
# MCP server or HTTPS business tool is enabled.
CRM_MCP_TOKEN=
TICKET_API_TOKEN=
# 0..1; parent-based sampling keeps an upstream sampled trace intact.
TRPC_AGENT_TRACE_SAMPLE_RATIO=0.1
# Fill these only when demo-wecom is enabled in configs/example.yaml.
WECOM_CALLBACK_TOKEN=replace-with-callback-token
WECOM_APP_SECRET=replace-with-application-secret
WECOM_ENCODING_AES_KEY=replace-with-43-character-encoding-aes-key
# Fill these only when demo-feishu is enabled via the Admin API.
FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
