TRPC_CONFIG=configs/demo.yaml
TRPC_ROLE=all
TRPC_HTTP_ADDR=127.0.0.1:8080
TRPC_POSTGRES_DSN=postgres://trpc:trpc@127.0.0.1:5432/trpc_agent?sslmode=disable
TRPC_REDIS_ADDR=127.0.0.1:6379
# The application uses the OTLP gRPC exporter. Local Docker Compose publishes
# only the Collector's gRPC receiver on loopback.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Point to files outside this repository. Never paste credentials here.
WECOM_CREDENTIAL_FILE=C:\\Users\\you\\Desktop\\企微bot.txt
# Optional for an unlabeled file whose first line is Secret and second line is BotID.
WECOM_CREDENTIAL_ORDER=botid_secret
FEISHU_CREDENTIAL_FILE=C:\\Users\\you\\Desktop\\飞书bot.txt
DEEPSEEK_KEY_FILE=C:\\Users\\you\\Desktop\\trpcapi.txt
