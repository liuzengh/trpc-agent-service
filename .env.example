# Development only. Use an external secret injector for production.
# Secret backend defaults to env for local development. Production may use
# file (Kubernetes Secret volume) or vault without changing SecretProvider.
TRPC_AGENT_SERVICE_SECRET_BACKEND=env
# TRPC_AGENT_SERVICE_SECRET_DIR=/var/run/secrets/trpc-agent-service
# TRPC_AGENT_SERVICE_VAULT_ADDR=https://vault.example.com
# TRPC_AGENT_SERVICE_VAULT_MOUNT=secret
# TRPC_AGENT_SERVICE_VAULT_TOKEN=inject-at-runtime
# TRPC_AGENT_SERVICE_VAULT_NAMESPACE=
# Optional host-port overrides allow multiple disposable Compose projects to run
# in parallel. Defaults are defined in compose.yaml.
# TRPC_AGENT_SERVICE_COMPOSE_POSTGRES_PORT=55432
# TRPC_AGENT_SERVICE_COMPOSE_REDIS_PORT=56379
# TRPC_AGENT_SERVICE_COMPOSE_QDRANT_HTTP_PORT=56333
# TRPC_AGENT_SERVICE_COMPOSE_QDRANT_GRPC_PORT=56334
# TRPC_AGENT_SERVICE_COMPOSE_GATEWAY_PORT=8080
# TRPC_AGENT_SERVICE_COMPOSE_JAEGER_PORT=16686
# TRPC_AGENT_SERVICE_COMPOSE_PROMETHEUS_PORT=19090
# TRPC_AGENT_SERVICE_COMPOSE_GRAFANA_PORT=13000
# TRPC_AGENT_SERVICE_COMPOSE_ADMIN_UI_PORT=4173
# If TRPC_AGENT_SERVICE_SHUTDOWN_TIMEOUT changes, keep this grace period longer.
# TRPC_AGENT_SERVICE_COMPOSE_STOP_GRACE_PERIOD=45s
POSTGRES_PASSWORD=development-only-change-me
TRPC_AGENT_SERVICE_POSTGRES_DSN=postgres://trpc:development-only-change-me@postgres:5432/trpc_agent_service?sslmode=disable
TRPC_AGENT_SERVICE_REDIS_URL=redis://redis:6379/0
TRPC_AGENT_SERVICE_REDIS_STREAM=trpc-agent-service:dispatch
TRPC_AGENT_SERVICE_REDIS_GROUP=workers
TRPC_AGENT_SERVICE_ADMIN_TOKEN=development-only-admin-token
# Optional least-privilege control-plane credentials. A configured role token
# must have an explicit comma-separated tenant allowlist.
# TRPC_AGENT_SERVICE_OPERATOR_TOKEN=development-only-operator-token
# TRPC_AGENT_SERVICE_OPERATOR_TENANT_IDS=tenant-a,tenant-b
# TRPC_AGENT_SERVICE_AUDITOR_TOKEN=development-only-auditor-token
# TRPC_AGENT_SERVICE_AUDITOR_TENANT_IDS=tenant-a,tenant-b
TRPC_AGENT_SERVICE_MODEL_TIMEOUT=1m
TRPC_AGENT_SERVICE_SHUTDOWN_TIMEOUT=30s
TRPC_AGENT_SERVICE_WORKER_CONCURRENCY=4
TRPC_AGENT_SERVICE_ARTIFACT_RETENTION=720h
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-change-me
TRPC_AGENT_SERVICE_JAEGER_URL=http://localhost:16686
TRPC_AGENT_SERVICE_PROMETHEUS_URL=http://localhost:19090
TRPC_AGENT_SERVICE_GRAFANA_URL=http://localhost:13000
TRPC_AGENT_SERVICE_OTEL_PROTOCOL=grpc
TRPC_AGENT_SERVICE_OTEL_TRACES_ENDPOINT=otel-collector:4317
TRPC_AGENT_SERVICE_OTEL_METRICS_ENDPOINT=otel-collector:4317

# Optional endpoints and scoped credentials are selected by a tenant's immutable
# AppConfig. Keep real values in an ignored .env file or an external secret
# injector; do not commit provider API keys here.
TRPC_AGENT_SERVICE_COS_ENDPOINTS={}
TRPC_AGENT_SERVICE_QDRANT_ENDPOINTS={}
TRPC_AGENT_SERVICE_TENCENTDB_GATEWAYS={}

# Docker Quick Start does not enable a real WeCom/Feishu binding, so it does
# not need the platform-internal IM keys. For real IM, inject one pair per
# (tenant_id, app_id) using the scoped key format documented in
# docs/deployment.md; keep those values in an ignored env file or secret
# manager, never in this example file.
