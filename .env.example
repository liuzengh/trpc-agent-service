# P1-09 local Docker/Compose deployment placeholders.
# Copy to a private env file, replace the run id, and generate the PostgreSQL
# password file (0600) at $P109_SECRET_DIR/pg_password before starting.
# Every value here is a local-only placeholder: none of them may be used for
# production, and copying this file must never enable Production Milvus, a
# real Model/Embedding Provider or real Telegram/Lark channels.

# Unique run id; must match [a-z0-9-]. Compose resource names embed it.
P109_RUN_ID=local

# Bounded loopback-only published ports.
P109_APP_PORT=18080
P109_PG_PORT=15432

# Directory (0700) that contains pg_password (0600). Never inside the repo.
P109_SECRET_DIR=

# Application image reference produced by the Dockerfile build.
P109_APP_IMAGE=p109-deploy-app:local

# Telemetry profile (default empty = P1-07 no-export; no collector client is
# constructed). Only set these together with `--profile telemetry`.
P109_TELEMETRY_ENDPOINT=
P109_TELEMETRY_MODE=
P109_TELEMETRY_INSECURE_LOCAL=

# P2-02 recovery profile (default OFF; only used with `--profile recovery`).
# Unique run id embedded in the p202-recovery-<run-id> resource names, a 0700
# directory holding the 0600 p202_pg_password / p202_pg_runtime_password
# secret files (outside the repo), and the locally built recovery tool image.
P202_RUN_ID=local
P202_SECRET_DIR=
P202_TOOL_IMAGE=p202-recovery-tool:local
P202_APP_PORT=18082
