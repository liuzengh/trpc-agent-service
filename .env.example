# Chat model (DeepSeek V4 Flash)
DEEPSEEK_API_KEY=

# Independent OpenAI-compatible embedding service for pgvector Memory
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Local deployment credentials
ADMIN_PASSWORD=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
MEM0_JWT_SECRET=change-me
MEM0_LLM_API_KEY=

# Feishu event-subscription (tenant-a). Bind channel "feishu" with
# app_secret/verification_token/encrypt_key as env: refs. Needs a public HTTPS URL.
FEISHU_APP_SECRET_TENANT_A=
FEISHU_VERIFY_TENANT_A=
FEISHU_ENCRYPT_KEY_TENANT_A=

# WeCom AI-bot (智能机器人) long-connection. ROUTE_KEYS must equal the
# binding route_key with channel "wecombot".
WECOMBOT_ROUTE_KEYS=
WECOM_BOT_SECRET=
