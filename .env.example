# V1: one PostgreSQL instance/database, fixed schemas, independent roles.
# Fresh database only. Legacy public tables/channel_gateway database require an
# explicit offline migration; provisioning never moves or deletes existing data.
PLATFORM_POSTGRES_DB=agent_platform
PLATFORM_POSTGRES_USER=platform_admin
PLATFORM_POSTGRES_PASSWORD=
CONTROL_MIGRATOR_PASSWORD=
CONTROL_RUNTIME_PASSWORD=
GATEWAY_MIGRATOR_PASSWORD=
GATEWAY_RUNTIME_PASSWORD=
WORKER_MIGRATOR_PASSWORD=
WORKER_RUNTIME_PASSWORD=
SESSION_MIGRATOR_PASSWORD=
SESSION_RUNTIME_PASSWORD=
# Required, independent DSNs with URL-encoded passwords; same host/port/database.
# Compose host is postgres; host-side development uses its published address.
# postgres://control_runtime:<encoded>@postgres:5432/agent_platform?sslmode=disable
CONTROL_DATABASE_URL=
# postgres://control_migrator:<encoded>@postgres:5432/agent_platform?sslmode=disable
CONTROL_MIGRATION_DATABASE_URL=
# Required: standard-base64 encoding of 32 random bytes. Keep the same key for
# every replica/restart using this database; store it outside the repository.
CONTROL_PROFILE_CREDENTIAL_KEY=
# Required release-pinned digest of the frozen V1 deployment contract.
# Recompute once during release preparation with -print-deployment-contract-digest
# if the contract changes; persist the same expected value for every replica.
CONTROL_DEPLOYMENT_EXPECTED_CONTRACT_DIGEST=sha256:06e3236c021c1d9f7f9e507ec24c3134aa79ac48c08b0b2aa6f62cd5c47fc481
CONTROL_HTTP_ADDRESS=:8080
CONTROL_SESSION_LIFETIME=24h
CONTROL_SESSION_COOKIE_NAME=control_session
CONTROL_SESSION_COOKIE_SECURE=false
CONTROL_BOOTSTRAP_MODE=auto
CONTROL_BOOTSTRAP_USERNAME=platform-admin
CONTROL_BOOTSTRAP_DISPLAY_NAME=Platform Operator
CONTROL_BOOTSTRAP_PASSWORD=admin1234567

# Channel Gateway / JetStream. Inject unique values; none are generated by startup.
# DSN password must be URL-encoded; gateway role default selects gateway schema.
# postgres://gateway_runtime:<encoded>@postgres:5432/agent_platform?sslmode=disable
GATEWAY_DATABASE_URL=
# postgres://gateway_migrator:<encoded>@postgres:5432/agent_platform?sslmode=disable
GATEWAY_MIGRATION_DATABASE_URL=
NATS_GATEWAY_PASSWORD=
NATS_CONTROL_PASSWORD=
NATS_RECONCILER_PASSWORD=
NATS_WORKER_PASSWORD=
# Empty accounts file allows startup with no bot configured. Account secrets are
# environment references; do not place real token/secret values in JSON.
GATEWAY_TELEGRAM_ACCOUNTS_FILE=
GATEWAY_TELEGRAM_WEBHOOK_SECRET=

# WeCom account projection directory is mounted, so atomic file replacement is visible.
# The default deployment file is empty; no real Bot credentials are in this repo.
GATEWAY_WECOM_ACCOUNTS_DIR=./wecom
GATEWAY_WECOM_BOT_SECRET=
# Optional stable instance identifier; omitted generates a process-unique identifier.

# Gateway Control-backed production source (SDK credentials are resolved via mTLS).
# Instance identity must match the Control principal and be unique per live replica.
GATEWAY_ACCOUNT_SOURCE=control
GATEWAY_INSTANCE_ID=gateway-1
GATEWAY_CONTROL_URL=
GATEWAY_CONTROL_SCOPE_ID=
GATEWAY_CONTROL_SOURCE_EPOCH=
GATEWAY_PUBLIC_ORIGIN=
# Diagnostic runners share a claim budget, but require separate Control consumers.
GATEWAY_TELEGRAM_PREFLIGHT_ENABLED=true
GATEWAY_WECOM_PREFLIGHT_ENABLED=true
# Directory contains ca.pem, client.pem and client-key.pem; private key mode 0600.
GATEWAY_CONTROL_CERTS_DIR=

# Worker V1 overlay: deploy/compose/compose.worker-v1.yaml.
# All workload pairs share the configured database but never share SQL roles.
WORKER_DATABASE_URL=
WORKER_MIGRATION_DATABASE_URL=
SESSION_MIGRATION_DATABASE_URL=
WORKER_CONFIG_FILE=
CONTROL_RUNTIME_CONFIG_FILE=
# These directories are read-only mounts; keys/private config must be readable by
# the container's nonroot UID and have owner-only permissions where required.
CONTROL_CHANNEL_CONFIG_DIR=
CONTROL_RUNTIME_CONFIG_DIR=
WORKER_RUNTIME_CONFIG_DIR=
GATEWAY_WORKER_CERTS_DIR=
NATS_TLS_DIR=
# Must exceed Worker JSON shutdown_drain_timeout + shutdown_cancel_timeout +
# http_shutdown_timeout. This is an explicit operator choice, not a model limit.
WORKER_STOP_GRACE_PERIOD=
# Standalone Gateway pointing to an external Worker (the overlay fills these).
GATEWAY_WORKER_URL=
GATEWAY_WORKER_CA_FILE=
GATEWAY_WORKER_CERT_FILE=
GATEWAY_WORKER_KEY_FILE=
GATEWAY_NATS_CA_FILE=

# Standalone Control Channel listener configuration; the Worker overlay supplies
# /run/control-channel/config.json from CONTROL_CHANNEL_CONFIG_DIR.
CONTROL_CHANNEL_CONFIG_FILE=

# Optional operator-owned Telegram Bot API origin for self-hosted deployments.
# Empty preserves the SDK public endpoint. HTTPS or literal loopback HTTP only.
GATEWAY_TELEGRAM_API_URL=

# Optional platform-managed backend directory (non-secret, release-pinned JSON).
# Both files are platform configuration; target file permissions must be 600.
# These settings do not enable unimplemented Worker adapters.
CONTROL_PLATFORM_BACKEND_CATALOG_FILE=
CONTROL_PLATFORM_BACKEND_CATALOG_SHA256=
CONTROL_PLATFORM_BACKEND_TARGETS_FILE=
CONTROL_PLATFORM_BACKEND_TARGETS_SHA256=
