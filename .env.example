# HTTP server
TRPC_AGENT_ADDR=:8080
# Optional public origin for bin/trpc-local status; no credentials in this URL.
TRPC_AGENT_PUBLIC_BASE_URL=

# all, gateway, relay, worker, sender, jobs, or admin. Production deploys separate roles.
TRPC_AGENT_ROLE=all

# /chat and /inbound are disabled by default, including through local tunnels.
# To enable them, configure scoped callers with 32+ character random tokens.
# Shape: [{"name":"local-client","token":"<random token>","tenant_id":"tutorial-tenant","binding_keys":["tutorial-http"],"user_ids":["alice"]}]
TRPC_AGENT_HTTP_API_ENABLED=false
# Tutorial shortcut: grants only tutorial-tenant / tutorial-http / alice.
# Use TOKEN or PRINCIPALS_JSON, not both. Generate with openssl rand -hex 24.
TRPC_AGENT_HTTP_API_TOKEN=
TRPC_AGENT_HTTP_API_PRINCIPALS_JSON=

# Exact deployment-owned tenant/purpose/reference grants; no wildcard access.
# Values remain in separate env vars. See docs/governance-operations.md.
# Shape: [{"tenant_id":"tutorial-tenant","purpose":"telegram_bot","reference":"env://TELEGRAM_BOT_TOKEN"}]
TRPC_AGENT_SECRET_GRANTS_JSON=[]

# WeCom's hosted message MCP endpoint (not an application callback URL).
# The FULL URL contains an apikey and is a credential: do not log or commit it.
# bin/trpc-wecomcheck performs initialize/tools-list ONLY. Runtime access
# requires an explicit tenant secret grant and wecom_mcp binding (see docs).
WECOM_MCP_URL=
# Empty means no background MCP reads, even if URL and binding are present.
# Enable only after agreeing on groups/human IDs/start time and fingerprint-v1.
# Shape: [{"tenant_id":"tutorial-tenant","binding_id":"wecom-mcp-tutorial"}]
# Gateway/all roles only. Does not discover or subscribe to other conversations.
# IM bindings default to message_policy={"mode":"realtime","max_age_seconds":120}.
# The window prioritizes recent reception; it does not expire accepted messages.
# Historical gaps are backfilled independently within the approved subscription.
TRPC_AGENT_WECOM_MCP_TARGETS_JSON=[]

# One slot is reserved for recent traffic when concurrency > 1; no autostart.
TRPC_AGENT_WORKER_CONCURRENCY=4

# Admin API is disabled by default. When enabled, keep the bearer token in an
# injected Secret rather than committing it to .env.example.
TRPC_AGENT_ADMIN_ENABLED=false
TRPC_AGENT_ADMIN_TOKEN=
# Preferred multi-principal RBAC configuration. Keep tokens in an injected
# Secret; this empty example intentionally contains no credentials.
TRPC_AGENT_ADMIN_PRINCIPALS_JSON=

# Optional browser-managed, tenant-owned model connections (schema 28).
# A base64-encoded 32-byte key, e.g. openssl rand -base64 32. Back it up separately
# from PostgreSQL; never rotate it by simply replacing the value. Admin/Worker/
# Jobs must share the same key. Empty retains the existing env-only model setup.
TRPC_AGENT_MODEL_MASTER_KEY=
# Exact HTTP(S) origins a platform admin may use for managed connections.
# No paths, credentials, query strings or wildcards. Changes require restart.
TRPC_AGENT_MODEL_ALLOWED_ORIGINS=https://api.openai.com

# Optional deployment-owned Skills. No runtime filesystem or shell fallback.
# Example root: ./skills. Each reference pins name, version and checksum.
TRPC_AGENT_SKILLS_ROOT=
# Shape: [{"tenant_id":"tutorial-tenant","name":"json-digest","version":"1"}]
# Add grants for explicitly authorized tenants; no wildcard grants.
TRPC_AGENT_SKILL_GRANTS_JSON=[]
TRPC_AGENT_SANDBOX_ENABLED=false
# Must already be present on the selected local Docker daemon. Never auto-pulls.
# Requires /bin/sh and /bin/busybox; resolved to an immutable image ID at startup.
TRPC_AGENT_SANDBOX_IMAGE=alpine:3.22
TRPC_AGENT_SANDBOX_SOCKET=/var/run/docker.sock

# Optional node-local durable audit buffer for tenants explicitly configured
# with failure_mode=buffered. Empty keeps failure handling fail-closed.
# A configured directory must be private (0700) and persistent across restarts.
TRPC_AGENT_AUDIT_SPOOL_DIR=
TRPC_AGENT_AUDIT_SPOOL_MAX_RECORDS=10000

# Optional deployment-owned Agent MCP server JSON; requires a tenant grant
# with purpose=mcp_server. See docs/governance-operations.md before enabling.
MCP_DOCS_SERVER=
# Optional built-in, loopback-only project documentation MCP server. It runs
# with Worker/all roles and stops with the Agent. Its bearer token and matching
# URL (http://127.0.0.1:18090/mcp) belong in the MCP_DOCS_SERVER JSON above.
# This is not the WeCom messaging MCP endpoint and does not expose arbitrary files.
TRPC_AGENT_DOCS_MCP_ENABLED=false
TRPC_AGENT_DOCS_MCP_ADDR=127.0.0.1:18090
TRPC_AGENT_DOCS_MCP_ROOT=.
# Telegram attachment import is disabled in bindings by default and also
# requires purpose=telegram_media for the existing Bot Token reference.
# Optional S3/MinIO JSON: {"access_key_id":"...","secret_access_key":"..."}.
# Use a dedicated bucket-scoped identity, not the MinIO administrator.
# Requires purpose=artifact, reference=env://MINIO_ARTIFACT_CREDENTIALS and
# an active artifact Backend Binding with bucket/endpoint/region/path_style.
MINIO_ARTIFACT_CREDENTIALS=
# Optional PostgreSQL Memory connection, using a role restricted to its table.
# Requires purpose=memory, reference=env://MEMORY_POSTGRES_URL and an active
# Memory Backend Binding. Provision schema first, then use skip_db_init=true.
MEMORY_POSTGRES_URL=

# Keep "mock" for an offline, deterministic local model.
# Change it to "openai" to call OpenAI or an OpenAI-compatible endpoint.
TRPC_AGENT_MODEL_PROVIDER=mock

# Required when TRPC_AGENT_MODEL_PROVIDER=openai.
TRPC_AGENT_MODEL_NAME=
OPENAI_API_KEY=

# Optional for OpenAI-compatible providers. Leave empty for the SDK default.
OPENAI_BASE_URL=

# The /chat tutorial returns one JSON response, so streaming is off by default.
TRPC_AGENT_MODEL_STREAM=false

# Optional real embedding preflight: bin/trpc-embeddingcheck. These four values
# are separate from chat configuration and do NOT enable Knowledge at startup.
# Use an API root offering POST /embeddings, not a chat-only converter.
# Runtime enablement still requires an immutable revision, Backend Binding and
# tenant grant: purpose=embedding, reference=env://TRPC_AGENT_EMBEDDING_API_KEY.
TRPC_AGENT_EMBEDDING_MODEL=
TRPC_AGENT_EMBEDDING_BASE_URL=
TRPC_AGENT_EMBEDDING_API_KEY=
TRPC_AGENT_EMBEDDING_DIMENSIONS=
# Optional local Qdrant API credential. Set a random value before real use;
# grant purpose=knowledge only to the intended tenant and Backend Binding.
# Empty preserves the unauthenticated loopback-only tutorial default.
TRPC_AGENT_QDRANT_API_KEY=

# Session storage. Use "redis" for restart persistence and multi-instance
# sharing. Keep async persistence disabled in the implementation so a completed
# AppendEvent is visible in Redis before the call returns. Disk durability still
# depends on the Redis persistence policy.
TRPC_AGENT_SESSION_BACKEND=inmemory
TRPC_AGENT_SESSION_TTL=0s
# Used only when TRPC_AGENT_SESSION_BACKEND=postgres. The same PostgreSQL
# server may be shared while this prefix keeps framework session tables clear.
TRPC_AGENT_SESSION_POSTGRES_PREFIX=agent_runtime
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=trpc-agent-service

# Complete-turn coordination. "local" serializes the same Session inside one
# process. Use "redis" when multiple Agent Worker processes may handle the same
# Session. The Redis coordinator reuses REDIS_URL and REDIS_KEY_PREFIX above.
TRPC_AGENT_COORDINATOR_BACKEND=local
TRPC_AGENT_COORDINATOR_LEASE_TTL=30s
TRPC_AGENT_COORDINATOR_RENEW_INTERVAL=10s
TRPC_AGENT_COORDINATOR_RETRY_INTERVAL=50ms

# Message deduplication. Clients must reuse message_id when retrying the same
# message. Use "redis" when duplicate callbacks may reach different Workers.
# This cache TTL bounds direct /chat deduplication. Durable IM and /inbound
# additionally restore completed SQL Run/Outbound facts after cache expiry.
TRPC_AGENT_IDEMPOTENCY_BACKEND=local
TRPC_AGENT_IDEMPOTENCY_PROCESSING_TTL=2m
TRPC_AGENT_IDEMPOTENCY_COMPLETED_TTL=24h
TRPC_AGENT_IDEMPOTENCY_RENEW_INTERVAL=30s
TRPC_AGENT_IDEMPOTENCY_POLL_INTERVAL=50ms

# Control plane. In-memory keeps the tutorial dependency-free. Production uses
# PostgreSQL for tenants, apps, revisions, bindings and message journals.
TRPC_AGENT_CONTROL_PLANE_BACKEND=inmemory
TRPC_AGENT_POSTGRES_URL=postgres://trpc_agent:trpc_agent_dev@127.0.0.1:5432/trpc_agent?sslmode=disable
TRPC_AGENT_POSTGRES_AUTO_MIGRATE=true
TRPC_AGENT_POSTGRES_BOOTSTRAP_TUTORIAL=false
TRPC_AGENT_POSTGRES_MAX_OPEN_CONNS=20
TRPC_AGENT_POSTGRES_MAX_IDLE_CONNS=5
TRPC_AGENT_POSTGRES_CONN_MAX_LIFETIME=30m

# Durable Agent work queue. Redis Streams is used when Gateway and Worker run
# as separate processes. Consumer may be omitted to generate a node-local ID.
TRPC_AGENT_QUEUE_BACKEND=memory
TRPC_AGENT_QUEUE_STREAM=agent-runs
TRPC_AGENT_QUEUE_GROUP=agent-workers
TRPC_AGENT_QUEUE_CONSUMER=
TRPC_AGENT_QUEUE_BLOCK_TIMEOUT=1s
TRPC_AGENT_QUEUE_CLAIM_MIN_IDLE=30s
TRPC_AGENT_QUEUE_MAX_LEN=100000

# Tenant quotas and cost budgets. Use redis for cross-node rate/concurrency and
# daily token/cost accounting; policies live in tenant.quota_config.
TRPC_AGENT_QUOTA_BACKEND=local

# OpenTelemetry OTLP/gRPC export. Disabled keeps the SDK no-op while trace
# propagation remains active.
TRPC_AGENT_OTEL_ENABLED=false
TRPC_AGENT_OTEL_SERVICE_NAME=trpc-agent-service
TRPC_AGENT_OTEL_ENDPOINT=127.0.0.1:4317
TRPC_AGENT_OTEL_INSECURE=true
TRPC_AGENT_OTEL_SAMPLE_RATIO=1
