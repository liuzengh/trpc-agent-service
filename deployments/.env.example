# Copy to .env and adjust before `docker compose up`.
# Host ports for mysql/redis. Default to 3307/6379 so they don't clash with a
# local MySQL/Redis already listening on 3306/6379. The backend reaches them
# via the compose network (mysql:3306 / redis:6379), so changing these host
# ports does not require touching backend-compose.config.yaml.
MYSQL_PORT=3307
REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=trpc123
MYSQL_DATABASE=trpc_agent_service

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ARTIFACT_MINIO_USER=artifactadmin
ARTIFACT_MINIO_PASSWORD=artifactadmin
