# Copy to .env and adjust before `docker compose up`.
# Host ports for mysql/redis. Default to 3307/6379 so they don't clash with a
# local MySQL/Redis already listening on 3306/6379. The backend reaches them
# via the compose network (mysql:3306 / redis:6379), so changing these host
# ports does not require touching backend-compose.config.yaml.
MYSQL_PORT=3307
REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=trpc123
MYSQL_DATABASE=trpc_agent_service

# MySQL DSN injected into the backend as env TRPC_MYSQL_DSN and referenced by
# backend-compose.config.yaml (mysql.dsn: "${TRPC_MYSQL_DSN}"). Kept here, not
# in the committed config file, so the credential is not checked into git.
TRPC_MYSQL_DSN=root:trpc123@tcp(mysql:3306)/trpc_agent_service?parseTime=true&multiStatements=true

# Credential-store master key (AES-256-GCM). Injected into the backend as env
# TRPC_SECRET_MASTER_KEY; never stored in the mounted config. Change it in prod.
TRPC_SECRET_MASTER_KEY=dev-master-key-change-me

# Owner bootstrap. Used once, when the member table is empty, to create the
# first owner: set a real password before the first start of a production
# deployment. Leaving it unset is refused by docker-compose.prod.yml and, with
# server.production=true, disables the bootstrap entirely rather than creating a
# well-known account.
ADMIN_USER_ID=admin
ADMIN_PASSWORD=change-me-before-starting

# JWT signing secret. Separate from the master key so rotating one does not
# invalidate the other; without it the platform falls back to a built-in
# development value, which is why production refuses to start.
TRPC_JWT_SECRET=change-me-to-a-long-random-string

# Optional: release label reported by GET /version. The prod overlay passes it
# into the image, which is how a rollout is verified from outside.
APP_VERSION=prod
# Worker replicas for the prod overlay; `--scale backend-worker=N` overrides it.
WORKER_REPLICAS=2

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ARTIFACT_MINIO_USER=artifactadmin
ARTIFACT_MINIO_PASSWORD=artifactadmin

# Compose profiles. `full` enables every optional service (vector KBs, artifact
# MinIO, observability), which is what `docker compose up` starts by default.
# For a core-only stack (mysql/redis/backend/frontend) run:
#   COMPOSE_PROFILES= docker compose up -d
COMPOSE_PROFILES=full
