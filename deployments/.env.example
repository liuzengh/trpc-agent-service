# Copy to .env and adjust before `docker compose up`.
# Host ports for mysql/redis. Default to 3307/6379 so they don't clash with a
# local MySQL/Redis already listening on 3306/6379. The backend reaches them
# via the compose network (mysql:3306 / redis:6379), so changing these host
# ports does not require touching backend-compose.config.yaml.
MYSQL_PORT=3307
REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=trpc123
MYSQL_DATABASE=trpc_agent_service

# MySQL DSN injected into the backend as env TRPC_MYSQL_DSN and referenced by
# backend-compose.config.yaml (mysql.dsn: "${TRPC_MYSQL_DSN}"). Kept here, not
# in the committed config file, so the credential is not checked into git.
TRPC_MYSQL_DSN=root:trpc123@tcp(mysql:3306)/trpc_agent_service?parseTime=true&multiStatements=true

# Credential-store master key (AES-256-GCM). Injected into the backend as env
# TRPC_SECRET_MASTER_KEY; never stored in the mounted config. Change it in prod.
TRPC_SECRET_MASTER_KEY=dev-master-key-change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ARTIFACT_MINIO_USER=artifactadmin
ARTIFACT_MINIO_PASSWORD=artifactadmin
