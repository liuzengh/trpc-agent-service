# Copy to .env and adjust before `docker compose up`.
# Host ports for mysql/redis. Default 3307 avoids clashing with a local MySQL
# on 3306. Backend reaches them via the compose network, so DSN is unaffected.
MYSQL_PORT=3307
REDIS_PORT=6379

MYSQL_ROOT_PASSWORD=trpc123
MYSQL_DATABASE=trpc_agent_service

# Credential-store master key (AES-256-GCM). Injected into the backend as env
# TRPC_SECRET_MASTER_KEY; never stored in the mounted config. Change it in prod.
TRPC_SECRET_MASTER_KEY=dev-master-key-change-me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

ARTIFACT_MINIO_USER=artifactadmin
ARTIFACT_MINIO_PASSWORD=artifactadmin
